{% extends 'base.html.twig' %}

{% block title %}Edit Base{% endblock %}

{% block body %}
    <div class="px-4 md:px-2 lg:px-0 py-8 space-y-8" xmlns:twig="http://www.w3.org/1999/html">
        <twig:Title:H1>{% trans %} title.base.single{% endtrans %}</twig:Title:H1>

        {{ include('preference/base/_form.html.twig', {'button_label': 'button.update'}) }}
        <div class="w-full my-8 flex flex-col md:flex-row space-y-4 lg:space-y-0 lg:space-x-4">
            <twig:Button:Secondary
                    href="{{ path('app_preference_base_index') }}">{{ ux_icon('mdi:arrow-left-thin', {'class': "w-5 h-5"}) }}{% trans %} button.back{% endtrans %}</twig:Button:Secondary>


            {{ include('preference/base/_delete_form.html.twig') }}
        </div>
    </div>
{% endblock %}
