<form method="post" action="{{ path('app_preference_base_delete', {'id': base.id}) }}" onsubmit="return confirm('Are you sure you want to delete this item?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ base.id) }}">
    <twig:Button:Danger class="space-x-2">{{ ux_icon('mdi:delete-outline', {'class': "w-5 h-5"}) }} Delete</twig:Button:Danger>
</form>
