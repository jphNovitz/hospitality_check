<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Welcome!{% endblock %}</title>
    <link rel="icon"
          href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text></svg>">
    {% block stylesheets %}
        <link rel="stylesheet" href="{{ asset('styles/app.css') }}">

    {% endblock %}

    {% block javascripts %}
        {% block importmap %}{{ importmap('app') }}{% endblock %}

    {% endblock %}
</head>
<body class="w-screen overflow-x-hidden bg-light-neutral  text-light-text-base dark:bg-dark-neutral dark:text-dark-text-base p-2 lg:p-8">
<div class="min-h-screen max-w-md lg:max-w-7xl m-auto p-4 bg-dark-neutral/5 dark:bg-light-neutral/5">
    <main class="min-h-screen xl:min-h-screen">

        <div class="w-full flex justify-between items-center mb-12">
            <div class="w-full ">
                Hospitality check
            </div>
            <div>
                {% if app.user %}
                    <a href="{{ path('app_logout') }}"> {% trans %}button.logout{% endtrans %} </a>
                {% else %}
                    <a href="{{ path('app_login') }}"> {% trans %}button.login{% endtrans %} </a>
                {% endif %}
            </div>
        </div>
        <main class="w-full p-2">
            {% block body %}{% endblock %}
        </main>

    </main>
</div>
<footer class="w-full bg-primary-light mt-16">
    <p>&copy; 2023 Roomate - Tous droits réservés.</p>
</footer>
</body>
</html>
