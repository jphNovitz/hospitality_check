<div class="text-center text-black/60 dark:text-white/50">
    <img class="mx-auto mb-4 w-36 h-36 rounded-full" src="{{ asset('images/resident/' ~ resident.picture) }}"
         alt="{{ resident.firstname }}">
    <h3 class="mb-1 text-2xl font-bold tracking-tight text-gray-900 dark:text-white">
        <a href="{{ path('app_resident_show', {'slug': resident.slug}) }}">{{ resident.firstname }}</a>
    </h3>
    <p>Referent:
        <span class="font-semibold">{% if resident.referent %}{{ resident.referent.name }}{% else %} {{ 'text.no_one' | trans }} {% endif %}</span>
    </p>
    <p>Chambre: <span class="font-semibold">{{ resident.room }}</span></p>

