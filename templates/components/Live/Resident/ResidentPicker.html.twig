<div{{ attributes.defaults({class: "w-full  mx-auto my-8"}) }}>
    <div class="mx-auto space-y-4">

        <div class="w-full flex flex-col md:flex-row space-x-0 md:space-x-4 space-y-4 md:space-y-0">
            <twig:Button:Primary href="{{ path('app_room') }}" class="md:!w-48">
                {% trans %} button.room.selection {% endtrans %}
            </twig:Button:Primary>

            <twig:Button:Primary href="{{ path('app_resident_new') }}" class="md:!w-48">
                {% trans %} button.add {% endtrans %}
            </twig:Button:Primary>
        </div>

        <div class="w-full md:pr-3">
            <input type="text"
                   data-model="query"
                   id="search_resident"
                   class="w-full leading-loose rounded-md bg-white/50 dark:bg-white/80 text-black font-semibold px-2 py-2 border border-black/50"/>
        </div>
    </div>
    <div class="w-full grid gap-8 lg:gap-16 grid-cols-1 md:grid-cols-3 lg:grid-cols-4 my-12">
        {% for resident in this.getResidents %}
            <twig:Card:Headline :resident="resident"/>
        {% endfor %}
    </div>
</div>
