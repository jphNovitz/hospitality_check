<div {{ attributes.defaults({ class: 'flex flex-col space-y-4' }) }}>
    {{ form_label(row,null, {
        'label': label,
        'label_attr': {'class': 'font-semibold'}
    }) }}
    <div class="flex">
        {{ form_widget(row.day, { 'attr':
            {
                'class': 'w-full flex bg-light-neutral dark:bg-dark-neutral text-light-text-base dark:text-dark-text-base   rounded-l-md px-1 py-2 outline-none focus:outline-none border-stone-300 focus:ring focus:border-stone-950'
            }
        }) }}
    {{ form_widget(row.month, { 'attr':
        {
            'class': 'w-full flex bg-light-neutral dark:bg-dark-neutral text-light-text-base dark:text-dark-text-base   px-1 py-2 outline-none focus:outline-none border-stone-300 focus:ring focus:border-stone-950'
        }
    }) }}
    {{ form_widget(row.year, { 'attr':
        {
            'class': 'w-full flex bg-light-neutral dark:bg-dark-neutral text-light-text-base dark:text-dark-text-base   rounded-r-md px-1 py-2 outline-none focus:outline-none border-stone-300 focus:ring focus:border-stone-950'
        }
    }) }}

    </div>
    {{ form_errors(row) }}
</div>