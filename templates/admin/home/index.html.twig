{% extends 'base.html.twig' %}

{% block title %} {% trans %}title.resident.list{% endtrans %} {% endblock %}

{% block body %}
    <div class="space-y-4 mb-16 ">
        <twig:Title:H2>{% trans %}title.resident.list{% endtrans %}</twig:Title:H2>

        <div class="w-full flex items-center justify-start space-x-4">
            <twig:Button:Secondary href="{{ path('admin_resident_index') }}" class="">
                {% trans %}button.list_all{% endtrans %}
            </twig:Button:Secondary>
            <twig:Button:Primary href="{{ path('app_resident_new') }}"
                                 class="">{% trans %}button.add{% endtrans %}
            </twig:Button:Primary>
        </div>

        {{ component('Live:List:Residents' ,{ limit: 5 }) }}
    </div>
    <div class="space-y-4 mb-16 ">
        <twig:Title:H2>{% trans %}title.user.list{% endtrans %}</twig:Title:H2>

        <div class="w-full flex items-center justify-start space-x-4">
            <twig:Button:Primary href="{{ path('app_register') }}"
                                 class="">{% trans %}button.add{% endtrans %}
            </twig:Button:Primary>
        </div>
        {{ component('Live:List:Users' ,{ limit: 5 }) }}

        <div class="w-full flex items-center justify-start space-x-4">
{#            <twig:Button:Secondary href="{{ path('admin_user_index') }}" class="">#}
{#                {% trans %}button.list_all{% endtrans %}#}
{#            </twig:Button:Secondary>#}
        </div>
    </div>
{% endblock %}
