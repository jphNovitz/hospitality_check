
<div class="w-full flex flex-col">
    {% set groups = {
        'interest': 'title.resident.interest',
        'do': 'title.resident.do',
        'dont': 'title.resident.dont',
        'other': 'title.resident.other'
    } %}

    {% for groupName, groupTitle in groups %}
        {% set characteristics = resident.characteristics|group[groupName]|default([]) %}
        
        {% if characteristics is not empty %}
            <div class="mb-4">
                <twig:Title:H2>{% trans %}{{ groupTitle }}{% endtrans %}</twig:Title:H2>
                <dl class="max-w-screen-md text-content-primary-light divide-y divide-black/30 dark:text-content-primary-dark dark:divide-white/30 mt-8">
                    {% for characteristic in characteristics %}
                        <div class="text-xl font-semibold ">
                            <div class="flex flex-col pb-3">
                                <dt class="mb-1 text-black/50 md:text-lg dark:text-white/50">{{ characteristic.name }}</dt>
                                <dd class="text-lg font-semibold">{{ characteristic.description }}</dd>
                            </div>
                        </div>
                    {% endfor %}
                </dl>
            </div>
        {% elseif groupName != 'other' %}
            {% trans %}text.resident.{{ groupName }}.empty{% endtrans %}
        {% endif %}
    {% endfor %}
</div>

